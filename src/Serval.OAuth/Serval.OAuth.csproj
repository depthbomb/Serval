<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework/>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Serval.OAuth</PackageId>
    <PackageTags>oauth;openid-connect;authentication</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>OAuth 2.0 clients and OpenID Connect provider sign-in for Serval.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>Serval.OAuth</Title>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0"/>
    <ProjectReference Include="../Serval.Authentication/Serval.Authentication.csproj"/>
  </ItemGroup>
</Project>
