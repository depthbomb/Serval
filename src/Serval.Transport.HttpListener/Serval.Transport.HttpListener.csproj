<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework/>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Serval.Transport.HttpListener</PackageId>
    <PackageTags>web;http;httplistener;websocket</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>HTTP listener and WebSocket transport for Serval using System.Net.HttpListener.</Description>
    <Title>Serval.Transport.HttpListener</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Serval/Serval.csproj"/>
  </ItemGroup>
</Project>
