<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework/>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Serval</PackageId>
    <PackageTags>web;http;controllers;routing;source-generator</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>An async controller web framework built on Microsoft.Extensions.Hosting.</Description>
    <Title>Serval</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0"/>
    <ProjectReference Include="../Serval.Generators/Serval.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"/>
  </ItemGroup>
  <Target Name="IncludeServalGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../Serval.Generators/Serval.Generators.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_ServalAnalyzerFile"/>
    </MSBuild>
    <ItemGroup>
      <None Include="@(_ServalAnalyzerFile)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>
  </Target>
</Project>
