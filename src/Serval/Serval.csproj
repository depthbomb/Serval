<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>An async controller web framework built on Microsoft.Extensions.Hosting.</Description>
    <Title>Serval</Title>
    <Authors>Caprine Logic</Authors>
    <Copyright>Copyright (c) 2026 Caprine Logic</Copyright>
    <PackageProjectUrl>https://github.com/depthbomb/serval</PackageProjectUrl>
    <RepositoryUrl>https://github.com/depthbomb/serval</RepositoryUrl>
    <Company>Caprine Logic</Company>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0"/>
    <ProjectReference Include="../Serval.Generators/Serval.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    <None Include="../Serval.Generators/bin/$(Configuration)/netstandard2.0/Serval.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
  </ItemGroup>
</Project>
