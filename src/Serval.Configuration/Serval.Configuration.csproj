<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework/>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Serval.Configuration</PackageId>
    <PackageTags>configuration;dotenv;environment;hosting</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Dotenv configuration files with explicit key mappings and standard .NET host integration.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>Serval.Configuration</Title>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0"/>
  </ItemGroup>
</Project>
