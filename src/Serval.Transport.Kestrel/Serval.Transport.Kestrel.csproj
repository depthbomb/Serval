<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework/>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Serval.Transport.Kestrel</PackageId>
    <PackageTags>web;http;kestrel;http2;http3;websocket</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Kestrel HTTP/1.1, HTTP/2, HTTP/3, and WebSocket transport for Serval.</Description>
    <Title>Serval.Transport.Kestrel</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <ProjectReference Include="../Serval/Serval.csproj"/>
  </ItemGroup>
</Project>
