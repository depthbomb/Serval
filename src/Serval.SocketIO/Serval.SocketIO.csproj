<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework/>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Serval.SocketIO</PackageId>
    <PackageTags>socketio;websocket;realtime</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Socket.IO 4.x events, namespaces, rooms, and acknowledgements over HTTP polling and WebSockets for Serval.</Description>
    <Title>Serval.SocketIO</Title>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Serval/Serval.csproj"/>
  </ItemGroup>
</Project>
