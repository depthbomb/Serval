<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework/>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Serval.Savanna</PackageId>
    <PackageTags>html;templates;views;source-generator</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Compiled, strongly typed HTML views for Serval.</Description>
    <Title>Serval.Savanna</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Serval/Serval.csproj"/>
    <ProjectReference Include="../Serval.Savanna.Generators/Serval.Savanna.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    <None Remove="build/Serval.Savanna.targets"/>
    <None Include="build/Serval.Savanna.targets" Pack="true" PackagePath="build/Serval.Savanna.targets"/>
  </ItemGroup>
  <Target Name="IncludeSavannaGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../Serval.Savanna.Generators/Serval.Savanna.Generators.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_SavannaAnalyzerFile"/>
    </MSBuild>
    <ItemGroup>
      <None Include="@(_SavannaAnalyzerFile)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>
  </Target>
</Project>
