<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework/>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Serval.SignedUrls</PackageId>
    <PackageTags>web;signed-urls;security</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Signed route URLs with readable payloads, validation, and optional expiration for Serval.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>Serval.SignedUrls</Title>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Serval/Serval.csproj"/>
  </ItemGroup>
</Project>
