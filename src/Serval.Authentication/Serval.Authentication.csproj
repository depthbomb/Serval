<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework/>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Serval.Authentication</PackageId>
    <PackageTags>web;authentication;authorization;cookies;csrf</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Composable authentication, sessions, password hashing, and authorization for Serval.</Description>
    <Title>Serval.Authentication</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Serval/Serval.csproj"/>
  </ItemGroup>
</Project>
